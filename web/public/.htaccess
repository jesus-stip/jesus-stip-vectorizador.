# Vectorizador: Apache settings for shared cPanel hosting.
# cPanel "Directory Privacy" adds its own Auth* lines to this file: keep them.

# WebAssembly must be served with its own MIME type for streaming compile
AddType application/wasm .wasm

# Always use HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # hashed build assets never change: cache them for a year
  <FilesMatch "\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the page itself must always be fresh so new deploys show up
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/wasm image/svg+xml
</IfModule>
